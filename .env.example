NODE_ENV=development
PORT=4173
APP_ORIGIN=http://localhost:4173
DATABASE_URL=postgresql://bugops:bugops@localhost:5432/bugops
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional OAuth providers. Login buttons appear only when credentials are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional backend-only AI key. Never expose this in config.js or browser code.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest
AI_RATE_LIMIT_PER_MINUTE=8
AI_DAILY_QUOTA=60
AI_TIMEOUT_MS=6000
AI_MAX_RETRIES=1
